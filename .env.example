# Quagga Portal — example environment variables.
# Every var here is OPTIONAL for boot: all three apps render a landing page and
# a graceful "not configured" banner when these are unset. Copy to `.env` at the
# repo root (or `.env.local` inside an app) and fill in to enable the DB- and
# auth-backed flows.
#
# When you ADD a variable, also add it to turbo.json `globalEnv` in the same
# change — otherwise Turbo's cache won't invalidate on a value change and
# you'll get stale builds.

# --- Database (Neon Postgres) ---
# Pooled/HTTP connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional: unpooled/direct connection string, used by migration tooling.
DATABASE_URL_UNPOOLED=

# Migrations run automatically at deploy time (each app's `build` script runs
# `db:migrate:deploy` before `next build` — see docs/deploy.md and AGENTS.md).
# There is no "the build never migrates" mode.

# --- Auth (self-hosted Better Auth, @quagga/auth) ---
# Auth is self-hosted against the same Neon database above — Neon's managed
# "Neon Auth" product is NOT used. Generate one shared secret and set the
# IDENTICAL value on every app/environment (a session signed by one app must
# verify in another): `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Per-app apex origin in production (e.g. https://app.example.org); previews
# derive it from VERCEL_URL when unset.
BETTER_AUTH_URL=
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=
AUTH_RATE_LIMIT_WINDOW_SECONDS=
AUTH_RATE_LIMIT_MAX=
# Shared apex domain across the three deployed apps (e.g. example.org) — used
# to scope cross-subdomain session cookies and the WebAuthn/passkey rpID.
# Leave unset for local/preview deployments (each app then behaves as its own
# origin, no cross-app SSO).
AUTH_APEX_DOMAIN=

# --- Google OAuth (optional) ---
# Email+password works without this. Callback is <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
# Handles auth / magic-link / notification delivery. Unset -> email flows are
# skipped rather than crashing.
RESEND_API_KEY=

# --- God bootstrap ---
# Comma-separated email list. On first login a matching (verified) address is
# granted the `god` (System manager) membership on the seeded AfrikaBurn org
# group. List at least two working-group addresses in production — a single
# god account is a lockout risk.
GOD_EMAILS=

# --- File storage (Vercel Blob) ---
# Backs registration layout uploads and questionnaire file uploads.
BLOB_READ_WRITE_TOKEN=

# --- Crypto (POPIA) ---
# Symmetric key for the always-private, encrypted ID-document columns on
# burner_bios (SA ID / passport). 16+ chars required, 32+ recommended. Rotate
# per the runbook in docs/auth-platform-spec.md. `openssl rand -base64 32`.
PGCRYPTO_KEY=

# --- In-app bug reporter (optional; web/org/suppliers) ---
# See docs/deploy.md §4a and docs/triage.md before enabling. GITHUB_TOKEN must
# belong to an org-owned identity (machine user or GitHub App), never a
# personal account — see GOVERNANCE.md.
GITHUB_TOKEN=
GITHUB_REPO=afrikaburn-theme-camp-app/ab-tc-app
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Scheduled jobs (optional, web only) ---
# Bearer tokens for the deletion-sweep, registration-deadline-reminder, and
# generic cron routes. CRON_SECRET is accepted by all of them; the
# per-route secrets below may instead be set individually. See docs/deploy.md.
ACCOUNT_SWEEP_SECRET=
CRON_SECRET=
REGISTRATION_REMINDER_SECRET=

# --- Neon Local proxy (dev-only escape hatch) ---
# Set to `1` ONLY when running the seed/migrate scripts against a Neon Local
# proxy container: it reconfigures the serverless driver to use a plain
# ws://host:5433/v1 WebSocket instead of secure Neon. Never set in production.
NEON_LOCAL_PROXY=
